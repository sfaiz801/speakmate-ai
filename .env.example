# Google Gemini API Configuration (Required for AI Tutor, Conversation & Interview Practice)
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Currently supported free-tier friendly models: gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Rate limiting / free-tier protection defaults
GEMINI_MAX_HISTORY_TURNS=10
GEMINI_MAX_INPUT_CHARS=1200

# Optional: Future Supabase Cloud Sync (Not required for MVP - LocalStorage is used by default)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
